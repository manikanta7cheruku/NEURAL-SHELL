{
  "manifest_version": 3,
  "name": "Seven Tab Sync",
  "version": "1.1.0",
  "description": "Lets Seven save and restore your browser tabs in workspaces. Works in Chrome, Edge and Brave. Everything stays on this computer.",
  "permissions": [
    "tabs",
    "activeTab",
    "identity",
    "identity.email",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:7777/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Seven Tab Sync — Active"
  }
}