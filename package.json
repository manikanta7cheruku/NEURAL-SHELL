{
    "name": "vii-desktop",
    "version": "1.3.3",
    "description": "SEVEN — Private AI Voice Assistant",
    "productName": "SEVEN",
    "author": {
        "name": "Manikanta Cheruku",
        "email": "your@email.com"
    },
    "main": "electron/main.js",
    "scripts": {
        "kill": "taskkill /F /IM SEVEN.exe /IM pythonw.exe /IM python.exe /IM Electron.exe /T 2>nul 1>nul & timeout /t 3 > nul",
        "clean": "rmdir /S /Q dist-electron 2>nul & echo cleaned",
        "build": "npm run kill && npm run clean && npm run build:frontend && npx electron-builder --config electron-builder.yml --x64",
        "dev": "concurrently \"npm run frontend:dev\" \"npm run electron:dev\"",
        "frontend:dev": "cd frontend && npm run dev",
        "electron:dev": "wait-on http://localhost:5173 && electron .",
        "build:frontend": "cd frontend && npm run build",
        "build:full": "node scripts/build.js",
        "dist": "npm run build:frontend && electron-builder --config frontend/electron-builder.yml",
        "dist:full": "node scripts/build.js",
        "prepare-python": "node scripts/prepare-python.js"
    },
    "devDependencies": {
        "concurrently": "^9.1.0",
        "electron": "^33.0.0",
        "electron-builder": "^25.0.0",
        "wait-on": "^8.0.0"
    },
    "dependencies": {
        "electron-store": "^10.0.0"
    }
}
